BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//VSCode iCalendar Syntax//Example//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Example Calendar
X-WR-TIMEZONE:Asia/Shanghai
BEGIN:VTIMEZONE
TZID:Asia/Shanghai
X-LIC-LOCATION:Asia/Shanghai
BEGIN:STANDARD
TZOFFSETFROM:+0800
TZOFFSETTO:+0800
TZNAME:CST
DTSTART:19700101T000000
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:example-event@example.com
DTSTAMP:20260110T010000Z
DTSTART;TZID=Asia/Shanghai:20260110T090000
DTEND;TZID=Asia/Shanghai:20260110T100000
SUMMARY:Example event
LOCATION:Shanghai
DESCRIPTION:An example event with a reminder
STATUS:CONFIRMED
TRANSP:OPAQUE
RRULE:FREQ=WEEKLY;COUNT=3;BYDAY=MO
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Reminder
TRIGGER:-P1D
END:VALARM
END:VEVENT
END:VCALENDAR
